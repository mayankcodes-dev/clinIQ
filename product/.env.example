# ═══════════════════════════════════════════════════════════════════════════════
# ClinIQ — Environment Variables Example
# Copy this file to .env for local development:  cp .env.example .env
# Production vars go in Cloudflare Workers → Settings → Variables and Secrets.
# NEVER prefix server secrets with NEXT_PUBLIC_ — they leak into the browser.
#
# The app starts and runs the interview without ANY keys set.
# Features degrade gracefully — no key = feature shows "not configured" or uses
# a free fallback (e.g., Bhashini TTS instead of ElevenLabs).
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── LLM — Groq (primary conversation & report engine) ─────────────────────────
# Free tier at https://console.groq.com/keys
# Without this: static fallback questions are served (interview still works)
GROQ_API_KEY=your_groq_api_key_here
# Optional second key — auto-used if primary hits 429/5xx rate limit
GROQ_API_KEY_2=your_groq_api_key_2_here

# ── Multimodal — Google Gemini (OCR + embeddings + LLM fallback) ───────────────
# Free tier at https://aistudio.google.com/app/apikey
# Without this: document scan disabled; keyword RAG used instead of vector RAG
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── TTS — ElevenLabs (optional premium voice) ──────────────────────────────────
# Free tier at https://elevenlabs.io (limited quota)
# Without this: Bhashini TTS / browser speech synthesis used automatically
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x

# ── ASR/TTS fallback — Bhashini Dhruva (22 Indian languages) ──────────────────
# Register at https://bhashini.gov.in/ulca
# Without this: browser Web Speech API used as final fallback
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── Database — Neon Postgres (doctor dashboard + queue) ────────────────────────
# Free tier at https://neon.tech
# Without this: doctor dashboard and clinic queue are disabled;
# patient interview, report generation, and PDF export still work fully.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────────
# Change NEXTAUTH_SECRET to any random 32+ character string in production
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
# PIN used by the doctor dashboard (/doctor route)
DOCTOR_PIN=1234

# ═══════════════════════════════════════════════════════════════
# ClinIQ — Environment Variables
# Copy to .env.local for local development
# All production vars go in Cloudflare Workers > Settings > Variables and Secrets
# NEVER prefix secrets with NEXT_PUBLIC_ — they end up in the browser JS bundle
# ═══════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.cliniq.mayankcodes.dev

# ── AI / TTS (Primary) — ElevenLabs ────────────────────────────
# Get key at https://elevenlabs.io
ELEVENLABS_API_KEY=sk_5dff5fba7cbcaa906f491db0e0f37ea89d4786ae3fa2ecb3
# Optional: override the default Aria voice
# ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x

# ── AI / LLM — xAI Grok (primary chat engine) ───────────────────
# Get key at https://x.ai
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1

# ── AI / Multimodal — Google Gemini ─────────────────────────────
# Used for: document OCR, embeddings, LLM fallback
GEMINI_API_KEY=

# ── ASR / TTS Fallback — Bhashini Dhruva ────────────────────────
# Server-side only (never NEXT_PUBLIC_) — get at https://bhashini.gov.in
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── Database — Neon Postgres ────────────────────────────────────
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────
# Secret for HMAC-SHA256 doctor token signing — use a strong random value in production
NEXTAUTH_SECRET=your-strong-random-secret-here
# Doctor kiosk PIN — change in production!
DOCTOR_PIN=1234

# ── ABDM / ABHA integration ──────────────────────────────────────
# Leave empty to use dev mock mode
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
